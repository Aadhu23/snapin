# --- Server ---------------------------------------------------------------
# Interface and port to bind.
SNAPIN_HOST=0.0.0.0
SNAPIN_PORT=8000

# DEBUG for verbose logs, INFO for normal operation.
SNAPIN_LOG_LEVEL=INFO

# --- Detection ------------------------------------------------------------
# Weights path. yolov8s.pt is downloaded on first run if not present locally.
SNAPIN_MODEL=yolov8s.pt

# Minimum confidence for a detection (0.0-1.0). Measured, not guessed: a real
# phone scores ~0.42-0.67 on live frames while bottles, remotes, and hands
# land at 0.10-0.24. Below ~0.3 you will get false alarms on desk clutter.
SNAPIN_CONF_THRESHOLD=0.4

# A phone must cover at least this fraction of the frame (0.0-1.0) to alert.
# Raise it to ignore a phone sitting far away on a desk.
SNAPIN_AREA_THRESHOLD=0.015

# Shape gate: bounding-box width/height. A phone held to a webcam is a tall
# rectangle (~0.3-0.9). Squarish or very wide boxes are usually remotes lying
# flat, hands, or speaker grilles. Widen only if real phones get rejected.
SNAPIN_MIN_ASPECT=0.28
SNAPIN_MAX_ASPECT=0.92

# Inference resolution. 320 matches 640 on sensitivity for small phones and
# runs ~3.5x faster; going ABOVE 640 reduces small-object recall sharply.
# Verify any change with: python backend/tune.py frame.jpg --sweep-imgsz
SNAPIN_IMGSZ=320
SNAPIN_IOU=0.45

# Test-time augmentation. Scores a small or oblique phone 3-10x higher, which
# is what makes small phones detectable at all. Costs ~60ms/frame at imgsz=320.
# Set to 0 to halve latency if you are CPU-bound.
SNAPIN_TTA=1

# Scan floor used so near-misses stay observable. A detection response carries
# a `reason` and `hint` when the phone was seen but a gate blocked it.
SNAPIN_DIAGNOSTIC_FLOOR=0.005

# Reject frames larger than this many bytes (default 5 MB).
SNAPIN_MAX_FRAME_BYTES=5242880

# --- Auth -----------------------------------------------------------------
# Set this in production. If left blank, one is generated on first run and
# saved to backend/.secret (gitignored, mode 0600) so sessions survive a
# server restart. Generate a value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SNAPIN_SECRET=

# Comma-separated origins allowed to make cross-origin requests. Leave blank
# for same-origin only (the default). Required if you serve the frontend from
# a different host than the API.
SNAPIN_ALLOWED_ORIGINS=

# Users, as JSON: {"alice":"her-password"} or {"alice":{"hash":"..."}}.
# Overrides backend/users.json when set. Prefer the CLI:
#   python backend/manage_users.py add alice
SNAPIN_USERS=

# Alternate location for the users file.
SNAPIN_USERS_FILE=

# --- Cookies --------------------------------------------------------------
# Set to 1 when serving over HTTPS so session cookies get the Secure flag.
SNAPIN_HTTPS=0

# Force the Secure flag on/off regardless of detection. Usually leave unset.
SNAPIN_COOKIE_SECURE=

# --- Debug ----------------------------------------------------------------
# Dump received frames to SNAPIN_DEBUG_DIR for inspection. Off by default
# because it writes your camera images to disk.
SNAPIN_SAVE_DEBUG=0
SNAPIN_DEBUG_DIR=./debug_frames