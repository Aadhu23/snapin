# Python virtual environment
venv/
.venv/
.venv-wsl/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment / secrets
.env
.env.*
!.env.example

# User credentials (regenerate with backend/manage_users.py)
backend/users.json

# Auto-generated signing secret, so sessions survive a restart
backend/.secret

# Runtime output
debug_input*.jpg

# IDE / editor
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Large ML model files
*.pt
*.pth
*.onnx

# Test/debug outputs
test_phone.png

# Local smoke-test client. Kept out of the repo because it points at a
# developer machine's server; run it from a local checkout if you need it.
test.py
